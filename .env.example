# ---- App ----
APP_NAME="blog"
ENVIRONMENT=dev
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# ---- Security ----
# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_DEV_ONLY_64_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Postgres ----
POSTGRES_USER=blogchat
POSTGRES_PASSWORD=blogchat_dev_password
POSTGRES_DB=blogchat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://blogchat:blogchat_dev_password@localhost:5432/blogchat

# ---- Redis (3 logical DBs: 0=celery broker, 1=celery results, 2=cache+pubsub) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_CELERY_BROKER=0
REDIS_DB_CELERY_RESULTS=1
REDIS_DB_CACHE=2
REDIS_URL_BROKER=redis://localhost:6379/0
REDIS_URL_RESULTS=redis://localhost:6379/1
REDIS_URL_CACHE=redis://localhost:6379/2

# ---- MinIO (S3-compatible) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=media
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ---- Ollama (installed in B7; kept here so config is complete) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SMALL=qwen2:1.5b
OLLAMA_MODEL_LARGE=qwen2:7b

# ---- Observability ----
METRICS_ENABLED=true
